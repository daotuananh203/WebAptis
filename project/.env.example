# ==============================================================================
# WebAptis B2 — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel/Docker deployment, configure these in your environment settings.
# IMPORTANT: All secrets here are SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# ==============================================================================

# 1. AI API Configuration (Google GenAI / Gemini)
# Required for AI Writing Grading, AI Speaking STT+Rubric, and AI Coach Tutor.
GEMINI_API_KEY="your-gemini-api-key-here"

# (Optional) Specific task model overrides (defaults to gemini-2.5-flash / gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_MODEL_WRITING="gemini-2.5-flash"
# GEMINI_MODEL_SPEAKING="gemini-2.5-flash"
# GEMINI_MODEL_COACH="gemini-2.5-flash"

# 2. Database Connection (PostgreSQL / Neon Database)
# Required for Production persistent user accounts, mock exam attempts, and error tracking.
# Format: postgres://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL="postgres://user:password@ep-sample-pooler.neon.tech/webaptis_db?sslmode=require"
# POSTGRES_URL="postgres://user:password@ep-sample-pooler.neon.tech/webaptis_db?sslmode=require"

# 3. Authentication & Session Security (Server Secret)
# Used for HMAC-SHA256 signing of session tokens. Must be at least 32 random characters in production.
AUTH_SECRET="generate-a-secure-random-64-character-hex-string-for-production"
# SESSION_SECRET="generate-a-secure-random-64-character-hex-string-for-production"

# 4. Runtime Mode
NODE_ENV="production"
# In local development or isolated CI without PostgreSQL, set ALLOW_MEMORY_STORE="true"
# In true production deployment, leave ALLOW_MEMORY_STORE unset to enforce PostgreSQL usage.
# ALLOW_MEMORY_STORE="false"
